{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "win-base",
      "hidden": true,
      "description": "Common settings. Dependency paths follow avisynth-build-win/build_release.bat; override them in a CMakeUserPresets.json.",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "BUILD_DIRECTSHOWSOURCE": "OFF",
        "ENABLE_PLUGINS": "ON"
      }
    },

    {
      "name": "deps-devil-x64",
      "hidden": true,
      "cacheVariables": {
        "BUILD_IMAGESEQ": "ON",
        "IL_LIBRARIES": "C:/avsplus_build_deps/DevIL Windows SDK/lib/x64/Release/DevIL.lib",
        "ILU_LIBRARIES": "C:/avsplus_build_deps/DevIL Windows SDK/lib/x64/Release/ILU.lib",
        "IL_INCLUDE_DIR": "C:/avsplus_build_deps/DevIL Windows SDK/include/IL"
      }
    },
    {
      "name": "deps-devil-win32",
      "hidden": true,
      "cacheVariables": {
        "BUILD_IMAGESEQ": "ON",
        "IL_LIBRARIES": "C:/avsplus_build_deps/DevIL Windows SDK/lib/x86/Release/DevIL.lib",
        "ILU_LIBRARIES": "C:/avsplus_build_deps/DevIL Windows SDK/lib/x86/Release/ILU.lib",
        "IL_INCLUDE_DIR": "C:/avsplus_build_deps/DevIL Windows SDK/include/IL"
      }
    },
    {
      "name": "deps-st-v143-x64",
      "hidden": true,
      "cacheVariables": {
        "BUILD_TIMESTRETCH": "ON",
        "SOUNDTOUCH_LINK_LIBRARIES": "C:/avsplus_build_deps/v143-x86-64/lib/SoundTouch.lib",
        "SOUNDTOUCH_INCLUDE_DIRS": "C:/avsplus_build_deps/v143-x86-64/include/soundtouch"
      }
    },
    {
      "name": "deps-st-v143-win32",
      "hidden": true,
      "cacheVariables": {
        "BUILD_TIMESTRETCH": "ON",
        "SOUNDTOUCH_LINK_LIBRARIES": "C:/avsplus_build_deps/v143-x86-32/lib/SoundTouch.lib",
        "SOUNDTOUCH_INCLUDE_DIRS": "C:/avsplus_build_deps/v143-x86-32/include/soundtouch"
      }
    },
    {
      "name": "deps-st-xp-x64",
      "hidden": true,
      "cacheVariables": {
        "BUILD_TIMESTRETCH": "ON",
        "SOUNDTOUCH_LINK_LIBRARIES": "C:/avsplus_build_deps/xp-x86-64/lib/SoundTouch.lib",
        "SOUNDTOUCH_INCLUDE_DIRS": "C:/avsplus_build_deps/xp-x86-64/include/soundtouch"
      }
    },
    {
      "name": "deps-st-xp-win32",
      "hidden": true,
      "cacheVariables": {
        "BUILD_TIMESTRETCH": "ON",
        "SOUNDTOUCH_LINK_LIBRARIES": "C:/avsplus_build_deps/xp-x86-32/lib/SoundTouch.lib",
        "SOUNDTOUCH_INCLUDE_DIRS": "C:/avsplus_build_deps/xp-x86-32/include/soundtouch"
      }
    },

    {
      "name": "vs-base",
      "hidden": true,
      "inherits": "win-base",
      "description": "Visual Studio generator: a .slnx/.sln in out/build/<preset>, for CMake GUI (Preset drop-down, Open Project).",
      "cacheVariables": {
        "ENABLE_INTEL_SIMD": "ON",
        "WINXP_SUPPORT": "OFF"
      }
    },
    {
      "name": "vs2026-base",
      "hidden": true,
      "inherits": "vs-base",
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "vs-v145-x64",
      "displayName": "VS 2026 v145 x64",
      "inherits": [ "vs2026-base", "deps-devil-x64", "deps-st-v143-x64" ],
      "architecture": "x64", "toolset": "v145"
    },
    {
      "name": "vs-v145-win32",
      "displayName": "VS 2026 v145 Win32",
      "inherits": [ "vs2026-base", "deps-devil-win32", "deps-st-v143-win32" ],
      "architecture": "Win32", "toolset": "v145"
    },
    {
      "name": "vs-v143-x64",
      "displayName": "VS 2026 v143 x64 (Win7)",
      "inherits": [ "vs2026-base", "deps-devil-x64", "deps-st-v143-x64" ],
      "architecture": "x64", "toolset": "v143"
    },
    {
      "name": "vs-v143-win32",
      "displayName": "VS 2026 v143 Win32 (Win7)",
      "inherits": [ "vs2026-base", "deps-devil-win32", "deps-st-v143-win32" ],
      "architecture": "Win32", "toolset": "v143"
    },
    {
      "name": "vs-clangcl-x64",
      "displayName": "VS 2026 ClangCL x64",
      "inherits": [ "vs2026-base", "deps-devil-x64", "deps-st-v143-x64" ],
      "architecture": "x64", "toolset": "ClangCL"
    },
    {
      "name": "vs-clangcl-win32",
      "displayName": "VS 2026 ClangCL Win32",
      "inherits": [ "vs2026-base", "deps-devil-win32", "deps-st-v143-win32" ],
      "architecture": "Win32", "toolset": "ClangCL"
    },
    {
      "name": "vs-intel-x64",
      "displayName": "VS 2026 Intel C++ 2025 (icx) x64 - needs the oneAPI environment",
      "description": "Start CMake GUI / the prompt after oneAPI setvars-vcvarsall.bat, otherwise CMake does not find the linker (CMAKE_LINKER-NOTFOUND).",
      "inherits": [ "vs2026-base", "deps-devil-x64", "deps-st-v143-x64" ],
      "architecture": "x64", "toolset": "Intel C++ Compiler 2025"
    },
    {
      "name": "vs2022-v141xp-x64",
      "displayName": "VS 2022 v141_xp x64 (XP)",
      "inherits": [ "vs-base", "deps-devil-x64", "deps-st-xp-x64" ],
      "generator": "Visual Studio 17 2022",
      "architecture": "x64", "toolset": "v141_xp",
      "cacheVariables": { "WINXP_SUPPORT": "ON" }
    },
    {
      "name": "vs2022-v141xp-win32",
      "displayName": "VS 2022 v141_xp Win32 (XP)",
      "inherits": [ "vs-base", "deps-devil-win32", "deps-st-xp-win32" ],
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32", "toolset": "v141_xp",
      "cacheVariables": { "WINXP_SUPPORT": "ON", "MSVC_CPU_ARCH": "SSE2" }
    },

    {
      "name": "x64-msvc",
      "hidden": true,
      "inherits": [ "win-base", "deps-devil-x64", "deps-st-v143-x64" ],
      "description": "Ninja + cl.exe of the Visual Studio that opened the folder (VS Open Folder), or of a x64 Native Tools prompt.",
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": { "intelliSenseMode": "windows-msvc-x64" }
      }
    },
    {
      "name": "x64-msvc-debug",
      "displayName": "x64 MSVC Debug (Ninja)",
      "inherits": "x64-msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "x64-msvc-release",
      "displayName": "x64 MSVC Release (Ninja)",
      "inherits": "x64-msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "arm64-llvm-mingw",
      "hidden": true,
      "inherits": "win-base",
      "description": "Windows on ARM64, cross-compiled with llvm-mingw (MinGW ABI, UCRT). Builds on x64, does not run there.",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/avisynth-build-win/toolchains/llvm-mingw-aarch64.cmake",
      "cacheVariables": {
        "AVS_LLVM_MINGW_ROOT": "C:/avsplus_build_deps/llvm-mingw-20261020-ucrt-x86_64",
        "ENABLE_INTEL_SIMD": "OFF",
        "BUILD_IMAGESEQ": "OFF",
        "BUILD_VDUBFILTER": "OFF",
        "BUILD_TIMESTRETCH": "ON",
        "SOUNDTOUCH_LINK_LIBRARIES": "C:/avsplus_build_deps/mingw-arm64/lib/libSoundTouch.a",
        "SOUNDTOUCH_INCLUDE_DIRS": "C:/avsplus_build_deps/mingw-arm64/include/soundtouch"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": { "intelliSenseMode": "windows-clang-arm64" }
      }
    },
    {
      "name": "arm64-llvm-mingw-debug",
      "displayName": "ARM64 llvm-mingw Debug (cross, PDB)",
      "inherits": "arm64-llvm-mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-gcodeview",
        "CMAKE_CXX_FLAGS": "-gcodeview",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-Wl,--pdb=",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-Wl,--pdb="
      }
    },
    {
      "name": "arm64-llvm-mingw-release",
      "displayName": "ARM64 llvm-mingw Release (cross)",
      "inherits": "arm64-llvm-mingw",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "posix-base",
      "hidden": true,
      "description": "Linux, macOS, BSD: default generator and compiler, default options (like a plain cmake -S . -B build).",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "posix-debug",
      "displayName": "Debug (default compiler)",
      "inherits": "posix-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "posix-release",
      "displayName": "Release (default compiler)",
      "inherits": "posix-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "vs-v145-x64", "configurePreset": "vs-v145-x64", "configuration": "Release" },
    { "name": "vs-v145-win32", "configurePreset": "vs-v145-win32", "configuration": "Release" },
    { "name": "vs-v143-x64", "configurePreset": "vs-v143-x64", "configuration": "Release" },
    { "name": "vs-v143-win32", "configurePreset": "vs-v143-win32", "configuration": "Release" },
    { "name": "vs-clangcl-x64", "configurePreset": "vs-clangcl-x64", "configuration": "Release" },
    { "name": "vs-clangcl-win32", "configurePreset": "vs-clangcl-win32", "configuration": "Release" },
    { "name": "vs-intel-x64", "configurePreset": "vs-intel-x64", "configuration": "Release" },
    { "name": "vs2022-v141xp-x64", "configurePreset": "vs2022-v141xp-x64", "configuration": "Release" },
    { "name": "vs2022-v141xp-win32", "configurePreset": "vs2022-v141xp-win32", "configuration": "Release" },
    { "name": "x64-msvc-debug", "configurePreset": "x64-msvc-debug" },
    { "name": "x64-msvc-release", "configurePreset": "x64-msvc-release" },
    { "name": "arm64-llvm-mingw-debug", "configurePreset": "arm64-llvm-mingw-debug" },
    { "name": "arm64-llvm-mingw-release", "configurePreset": "arm64-llvm-mingw-release" },
    { "name": "posix-debug", "configurePreset": "posix-debug" },
    { "name": "posix-release", "configurePreset": "posix-release" }
  ]
}
